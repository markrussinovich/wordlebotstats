{
  "manifest_version": 3,
  "name": "Wordle Companion — Play & Stats",
  "version": "1.1.1",
  "description": "Play unplayed Wordle puzzles in your popup or dashboard, track stats, and compare with NYT readers and a local solver.",

  "permissions": ["storage", "activeTab", "tabs"],

  "host_permissions": [
    "https://www.nytimes.com/games/wordle*",
    "https://www.nytimes.com/svc/wordle/v2/*",
    "https://www.nytimes.com/interactive/2022/upshot/wordle-bot.html",
    "https://static01.nyt.com/newsgraphics/2022/wordlebot/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://www.nytimes.com/games/wordle*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.nytimes.com/interactive/2022/upshot/wordle-bot.html"
      ],
      "js": ["wordleBotContent.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Wordle Companion — Play & Stats",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["dashboard.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
